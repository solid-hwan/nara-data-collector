# 환경변수 / 비밀
.env
.env.local
.env.*.local

# MCP 설정은 키 0개 (.env 에서 로드하는 래퍼 스크립트 경유). 커밋 대상.

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# uv / uvx
.uv-cache/
.venv*/

# Node
node_modules/
npm-debug.log*

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# 로그 / 임시 / DB
*.log
tmp/
temp/
.cache/
*.db
*.sqlite
*.sqlite3

# MCP 원시 응답 캐시 (대용량, 변동성). 규칙 파일만 유지.
# 2단계 구조: data/raw/{source}/{tool}/*.json
data/raw/**/*.json

# 영업 산출물 — 공개 저장소에 올리지 않는다 (2026-09-17).
# 이유: 이 세 디렉터리에는 수요기관 담당자 실명·전화번호·이메일이 들어 있다.
#   - data/processed/contacts.csv        담당자 68행 (전화 35건)
#   - data/reports/call/**              통화 대본 (전화 62건)
# API 응답 자체가 담당자 연락처를 포함하므로(ntceInsttOfclTel,
# fnlSucsfCorpContactTel 등) 가공 산출물도 같은 취급을 한다.
# 실데이터 정본은 비공개 저장소에 두고, 여기에는 구조 설명 README만 남긴다.
#
# 디렉터리 자체를 제외하면 그 안의 파일은 !패턴으로 되살릴 수 없으므로
# (git은 제외된 디렉터리를 아예 탐색하지 않는다), 와일드카드로 내용만 제외하고
# README.md 는 명시적으로 되살린다.
data/processed/**
data/reports/**
data/analysis/**
!data/processed/README.md
!data/reports/README.md
!data/analysis/README.md

# 빌드 결과
dist/
build/
*.egg-info/

# Claude 로컬 (팀 구조는 커밋, 세션/로컬 상태는 제외)
.claude/settings.local.json
.claude/.session/
